# --- FASE 1: COMPILACIÓN (BUILDER) ---
FROM node:18-alpine AS builder

WORKDIR /app

# Copiar archivos de dependencias
COPY package*.json ./
RUN npm ci

# Copiar el código fuente
COPY . .

# Compilar la aplicación React/Vite para producción (genera la carpeta /dist)
RUN npm run build

# --- FASE 2: EJECUCIÓN (RUNTIME) ---
# Usamos un servidor Nginx ligero para servir los archivos estáticos generados
FROM nginx:alpine

# Copiar los archivos estáticos compilados desde la fase builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copiar configuración personalizada de Nginx si es necesario para SPA
# (Requerido para manejar el enrutamiento interno de React Router en el cliente)
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
